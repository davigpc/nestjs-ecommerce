# Copie para .production.env (containers) ou .development.env (host).
NODE_ENV=production
PORT=3001

CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://mongo:27017/gldcart?replicaSet=rs0
MONGO_DATABASE=gldcart

REDIS_HOST=redis
REDIS_PORT=6379

ACCESS_SECRET=change_me_access_secret
ACCESS_EXPIRATION_TIME=1d
REFRESH_SECRET=change_me_refresh_secret
REFRESH_EXPIRATION_TIME=7d
REFRESH_TOKEN_NAME=refreshToken
REFRESH_TOKEN_PATH=api/auth/refresh

UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3001

FEEDBACK_EMAIL=no-reply@localhost
MONTHLY_SUBSCRIPTION_priceId=price_local_monthly

# Integracoes externas removidas no baseline do experimento:
# - Stripe: implementacao local em src/modules/stripe
# - AWS S3: disco local em src/modules/storages
# - SMTP: transporte em memoria em src/modules/email
# - Google OAuth: controller desligado no AuthModule
# - Twilio: modulo nao importado pelo main.module
SEED_BASE_URL=http://api:3001
